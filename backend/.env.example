NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Atlas — encode special chars in password (@ → %40, # → %23, etc.)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.amom2nv.mongodb.net/taskflow?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis (optional — set to true only if you run Redis locally)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
