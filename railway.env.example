# Copy these into Railway → your service → Variables
# Do NOT commit real secrets to git

NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/taskflow?retryWrites=true&w=majority
JWT_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
COOKIE_SECURE=true
REDIS_ENABLED=false
ADMIN_EMAIL=admin@taskflow.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=TaskFlow Admin

# Optional — auto-set from RAILWAY_PUBLIC_DOMAIN if omitted:
# FRONTEND_URL=https://your-app.up.railway.app
# CORS_ORIGIN=https://your-app.up.railway.app
